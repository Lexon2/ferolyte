{
  "name": "@ferolyte/pack",
  "version": "0.4.0",
  "description": "Ferolyte content SDK for Minecraft BE addons",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexon2/ferolyte.git",
    "directory": "packages/pack"
  },
  "bugs": {
    "url": "https://github.com/Lexon2/ferolyte/issues"
  },
  "homepage": "https://github.com/Lexon2/ferolyte#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./item": {
      "types": "./dist/item.d.ts",
      "import": "./dist/item.js",
      "default": "./dist/item.js"
    },
    "./block": {
      "types": "./dist/block.d.ts",
      "import": "./dist/block.js",
      "default": "./dist/block.js"
    },
    "./entity": {
      "types": "./dist/entity.d.ts",
      "import": "./dist/entity.js",
      "default": "./dist/entity.js"
    },
    "./molang": {
      "types": "./dist/molang.d.ts",
      "import": "./dist/molang.js",
      "default": "./dist/molang.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js",
      "default": "./dist/animation.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ferolyte/common": "^0.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "minecraft",
    "minecraft-bedrock",
    "bedrock",
    "bedrock-edition",
    "addon",
    "addons",
    "minecraft-addon",
    "mcaddon",
    "typescript",
    "sdk",
    "content",
    "blocks",
    "items",
    "entities",
    "ferolyte"
  ],
  "engines": {
    "node": ">=18"
  }
}
