{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noCheck": true,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@ferolyte/pack/*": [
        "./*"
      ],
      "@ferolyte/common/*": [
        "../common/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "dist",
    "**/*.test.ts",
    "**/*.d.ts"
  ]
}
