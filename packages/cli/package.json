{
  "name": "@ferolyte/cli",
  "version": "0.4.0",
  "description": "Ferolyte CLI and pack compiler for Minecraft BE addons",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexon2/ferolyte.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Lexon2/ferolyte/issues"
  },
  "homepage": "https://github.com/Lexon2/ferolyte#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ferolyte": "./dist/cli/index.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ferolyte/common": "^0.4.0",
    "@ferolyte/pack": "^0.4.0",
    "chokidar": "^4.0.3",
    "citty": "^0.2.2",
    "esbuild": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "uuid": "^13.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "minecraft",
    "minecraft-bedrock",
    "bedrock",
    "bedrock-edition",
    "addon",
    "addons",
    "minecraft-addon",
    "typescript",
    "cli",
    "compiler",
    "generator",
    "script-api",
    "watch",
    "mcaddon",
    "ferolyte"
  ],
  "engines": {
    "node": ">=18"
  }
}
