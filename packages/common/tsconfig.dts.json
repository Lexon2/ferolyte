{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noCheck": true,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "dist",
    "**/*.test.ts",
    "**/*.d.ts"
  ]
}
