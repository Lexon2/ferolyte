{
  "name": "@ferolyte/common",
  "version": "0.2.3",
  "description": "Shared utilities and content foundation for Ferolyte",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lexon2/ferolyte.git",
    "directory": "packages/common"
  },
  "bugs": {
    "url": "https://github.com/Lexon2/ferolyte/issues"
  },
  "homepage": "https://github.com/Lexon2/ferolyte#readme",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "minecraft",
    "minecraft-bedrock",
    "bedrock",
    "bedrock-edition",
    "addon",
    "addons",
    "minecraft-addon",
    "mcaddon",
    "typescript",
    "utilities",
    "shared",
    "content",
    "ferolyte"
  ],
  "engines": {
    "node": ">=18"
  }
}
